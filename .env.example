# =====================================================================
#  MAKLAYN — Variáveis de ambiente
#  Copie para ".env" e ajuste os valores:   cp .env.example .env
# =====================================================================

# ------------------------------------------------ Aplicação
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------ Banco de dados
# mysql  -> produção (conforme a especificação)  |  sqlite -> desenvolvimento local
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=maklayn
DB_PASSWORD=maklayn
DB_NAME=maklayn
DB_POOL=10
# Caminho do arquivo quando DB_CLIENT=sqlite (padrão: db/maklayn.sqlite)
# SQLITE_FILE=./db/maklayn.sqlite

# ------------------------------------------------ Sessão / JWT
# Gere um segredo forte:   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio
JWT_EXPIRA=28800

# ------------------------------------------------ Login com Google (OAuth 2.0)
# 1) console.cloud.google.com -> novo projeto
# 2) APIs e Serviços > Tela de consentimento OAuth (nome do app: Maklayn)
# 3) APIs e Serviços > Credenciais > Criar > ID do cliente OAuth > Aplicativo da Web
# 4) Em "URIs de redirecionamento autorizados", adicione:
#       http://localhost:3000/api/auth/google/callback
# 5) Copie o Client ID e o Client Secret abaixo (o Secret NUNCA vai para o frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Permite entrar com e-mail de teste (sem Google) enquanto você configura as credenciais.
# Em produção, mude para false.
ALLOW_DEMO_LOGIN=true

# ------------------------------------------------ Motor de IA
# mock   -> gerador didático local (sem custo, ótimo para desenvolvimento)
# gemini -> Google Gemini      (requer GEMINI_API_KEY)
# openai -> OpenAI e compatíveis (Groq, DeepSeek, OpenRouter, Ollama...)
AI_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Opcional: apontar para outro provedor OpenID Connect ou para o
# --- servidor de teste local (testes/google-falso.mjs). Em produção, deixe em branco.
# GOOGLE_AUTH_ENDPOINT=http://localhost:9099/o/oauth2/v2/auth
# GOOGLE_TOKEN_ENDPOINT=http://localhost:9099/token
# GOOGLE_USERINFO_ENDPOINT=http://localhost:9099/oauth2/v3/userinfo
# GOOGLE_TOKENINFO_ENDPOINT=http://localhost:9099/tokeninfo
# GOOGLE_JWKS_URI=http://localhost:9099/oauth2/v3/certs
